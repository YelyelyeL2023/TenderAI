# OWS v3 token issued by the organisation / Ministry of Finance. Never commit the real value.
OWS_TOKEN=
OWS_BASE_URL=https://ows.goszakup.gov.kz
DATABASE_URL=postgresql://tenderai:tenderai@localhost:5434/tenderai
# Read-only role used by the agent's SQL tools
AGENT_DATABASE_URL=postgresql://tenderai_agent:tenderai_agent@localhost:5434/tenderai
# Any OpenAI-compatible local server (Ollama / vLLM)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=local
# Layers offloaded to the GPU (99 = all; the 9B model fits fully in 8 GB VRAM)
LLM_NUM_GPU=99
